rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocIsValid(userId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'phoneNumber',
          'displayName',
          'updatedAt',
          'fcmTokens',
        ])
        && request.resource.data.id == userId
        && request.resource.data.phoneNumber is string
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('fcmTokens' in request.resource.data) || request.resource.data.fcmTokens is list);
    }

    function threadCreateIsValid() {
      return request.resource.data.keys().hasOnly([
          'name',
          'handle',
          'initials',
          'accentArgb',
          'participantIds',
          'participantPhones',
          'participantNames',
          'lastMessage',
          'lastMessageAtMillis',
          'lastMessageAt',
          'lastSenderId',
          'readBy',
          'createdAt',
        ])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 1
        && request.resource.data.participantIds.size() <= 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.name is string
        && request.resource.data.handle is string
        && request.resource.data.initials is string
        && request.resource.data.accentArgb is number
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageAtMillis is number
        && request.resource.data.lastSenderId is string
        && (!('readBy' in request.resource.data) || request.resource.data.readBy is map)
        && (!('participantPhones' in request.resource.data) || request.resource.data.participantPhones is map)
        && (!('participantNames' in request.resource.data) || request.resource.data.participantNames is map);
    }

    function threadUpdateIsValid() {
      return request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastMessage',
          'lastMessageAtMillis',
          'lastMessageAt',
          'lastSenderId',
          'readBy',
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageAtMillis is number
        && request.resource.data.lastSenderId is string
        && request.resource.data.readBy is map;
    }

    function senderIsValid(threadId, messageId) {
      return request.resource.data.senderId == request.auth.uid
        || (
          request.resource.data.senderId == 'system'
          && threadId == 'welcome-' + request.auth.uid
          && messageId == 'welcome-message-' + request.auth.uid
        );
    }

    function messageCreateIsValid(threadId, messageId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'senderId',
          'body',
          'createdAtMillis',
          'createdAt',
        ])
        && request.resource.data.id == messageId
        && senderIsValid(threadId, messageId)
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.createdAtMillis is number;
    }

    function isParticipant(threadId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && userDocIsValid(userId);
    }

    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && threadCreateIsValid();
      allow update: if signedIn() && threadUpdateIsValid();

      match /messages/{messageId} {
        allow read: if isParticipant(threadId);
        allow create: if isParticipant(threadId) && messageCreateIsValid(threadId, messageId);
      }
    }
  }
}
